VisualElement {
    transition-property: all, opacity;
    transition-duration: 0.5s, 1s;
    display: flex;
    transition-delay: 0s, 0s;
    transition-timing-function: ease, ease;
}

.data {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(40, 249, 255, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
}

.unity-disabled {
    opacity: 0.1;
    display: flex;
    visibility: visible;
    transition-delay: 0s, 0s;
}

.button-a {
    height: 25%;
    width: auto;
    flex-shrink: 1;
    flex-grow: 1;
    transition-duration: 1s, 1s;
}

.button-a:hover {
    background-color: rgb(0, 0, 0);
    height: 30%;
    color: rgb(255, 255, 255);
    transition-duration: 1s, 1s;
}

.data-updated {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(250, 255, 59, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
    transition-duration: 0s, 1s;
}

.data:hover {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(255, 203, 0, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
    transition-duration: 0s, 1s;
}
