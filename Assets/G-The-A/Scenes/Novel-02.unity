    - target: {fileID: 1428811554074361250, guid: 0e8a6555642a26f4f8f2ba156f076cd0, type: 3}
      propertyPath: dialogueDatas.Array.data[2].text
      value: "\u0414\u0430 \u0447\u0442\u043E \u0432 \u043A\u043E\u0440\u043E\u0431\u043A\u0435\u0435\u0435\u0435\u0435\u0435??!!!"
