VisualElement {
    transition-property: all, opacity;
    transition-duration: 0.5s, 1s;
    display: flex;
    transition-delay: 0s, 0s;
    transition-timing-function: ease, ease;
}

.data {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(40, 249, 255, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
}

.unity-disabled {
    opacity: 0;
    display: flex;
    visibility: visible;
    transition-delay: 0s, 0s;
}

.button-a {
    height: 25%;
    width: auto;
    flex-shrink: 1;
    flex-grow: 1;
    transition-duration: 1s, 1s;
}

.button-a:hover {
    background-color: rgb(0, 0, 0);
    height: 30%;
    color: rgb(255, 255, 255);
    transition-duration: 1s, 1s;
}

.data-updated {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(250, 255, 59, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
    transition-duration: 0s, 1s;
}

.data:hover {
    flex-grow: 0;
    height: 100%;
    background-color: rgba(255, 203, 0, 0.55);
    flex-direction: column;
    white-space: normal;
    text-overflow: clip;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    align-content: center;
    justify-content: space-around;
    -unity-text-align: upper-left;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
    transition-duration: 0s, 1s;
}

.hide {
    opacity: 0;
}

.dialogue-select {
    flex-grow: 1;
    background-color: rgba(0, 18, 255, 0.24);
    width: 40%;
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    align-self: auto;
    align-items: center;
    justify-content: space-evenly;
    flex-wrap: wrap;
    flex-direction: column;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-top-color: rgba(0, 0, 0, 0.2);
    border-bottom-color: rgba(0, 0, 0, 0.2);
    min-width: 30%;
}

.dialogue-select-button {
    width: auto;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 4px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    transition-duration: 0.1s, 1s;
    min-width: 0%;
}

.dialogue-select-button:hover {
    width: auto;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(0, 26, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 4px;
    padding-top: 12px;
    padding-right: 10px;
    padding-bottom: 12px;
    padding-left: 10px;
}
