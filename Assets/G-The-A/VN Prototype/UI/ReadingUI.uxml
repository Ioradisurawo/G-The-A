        <ui:VisualElement name="loading-screen" enabled="true" style="flex-grow: 1; -unity-material: url(&quot;project://database/Assets/G-The-A/VN%20Prototype/UI/UI%20Noise.shadergraph?fileID=-876546973899608171&amp;guid=ad8384c6d97bc5444bb7e5bd6b0d8de2&amp;type=3#UI Noise&quot;); background-color: rgb(255, 255, 255); position: absolute; top: 1px; left: 0; right: 1px; bottom: 0; display: none;">
            <ui:Label text="[ Загрузка ]" style="background-color: rgb(0, 0, 0); margin-bottom: 0; margin-top: 8px; margin-right: 8px; margin-left: 0; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); width: auto; -unity-text-align: upper-center; right: auto; bottom: auto; align-self: flex-end; font-size: 36px; white-space: nowrap; text-overflow: clip; -unity-font-style: bold;"/>
