    disappearEvents: []
  - speaker: "\u0413\u0435\u0440\u043E\u0439"
    text: ...
    appearEvents: []
    disappearEvents: []
  - speaker: "\u0413\u0435\u0440\u043E\u0439"
    text: "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0438\u0430\u043B\u043E\u0433."
